config GNSS_TELIT_LE910CX
	bool "Telit LE910CX GNSS modem driver"
	default y
	depends on MODEM_CELLULAR
	depends on DT_HAS_TELIT_LE910C1TX_ENABLED
	depends on DT_HAS_TELIT_LE910CX_GNSS_ENABLED
	select MODEM_MODULES
	select MODEM_CHAT
	select MODEM_CHAT_COMMANDS_CONDITIONAL
	select MODEM_PIPE
	select MODEM_AT_USER_PIPE
	select GNSS_NMEA0183
	help
	  Enable Telit LE910CX GNSS modem driver.

config GNSS_TELIT_LE910CX_INIT_PRIORITY
	int "Telit LE910CX GNSS initialization priority"
	default 92
	depends on GNSS_TELIT_LE910CX
	help
	  Initialization priority of the Telit LE910CX GNSS driver. Must be
	  greater than MODEM_CELLULAR_INIT_PRIORITY, as the GNSS device is a
	  child of the cellular modem device.
